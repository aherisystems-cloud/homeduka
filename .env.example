# HOME KENYA MARKETPLACE - ENVIRONMENT CONFIGURATION ($0 ARCHITECTURE)

# 1. Supabase PostgreSQL & PostGIS (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Gemini 2.0 Flash AI API (Free Tier via Google AI Studio)
# 1,500 free requests per day for voice/vision extraction and SEO copywriting
GEMINI_API_KEY=your-google-ai-studio-gemini-key

# 3. Cloudflare R2 Storage (Free Tier: 10GB storage, $0 egress fees)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=home-kenya-media
NEXT_PUBLIC_CDN_URL=https://media.homekenya.co.ke

# 4. Zoho One & Zoho Flow Webhook Relay (Internal HQ)
ZOHO_FLOW_WEBHOOK_URL=https://flow.zoho.com/api/v1/webhook/your-webhook-endpoint

# 5. WhatsApp Integration (Deep Linking & Notifications)
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=254700000000
NEXT_PUBLIC_APP_URL=https://homekenya.co.ke
